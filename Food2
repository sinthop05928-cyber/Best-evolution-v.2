-- Food Spawn System
-- ใส่ Script นี้ใน ServerScriptService

local Players = game:GetService("Players")

-- ตั้งค่าพื้นที่เกิดอาหาร
local MAP_CENTER = Vector3.new(0, 2, 0)
local MAP_SIZE = Vector3.new(300, 0, 300)

-- อาหารและ EXP
local Foods = {
	{
		Name = "🥬",
		EXP = 5,
		RespawnTime = 15
	},
	{
		Name = "🍎",
		EXP = 10,
		RespawnTime = 25
	},
	{
		Name = "🍖",
		EXP = 20,
		RespawnTime = 45
	}
}

-- สร้างโฟลเดอร์อาหาร
local FoodFolder = Instance.new("Folder")
FoodFolder.Name = "Foods"
FoodFolder.Parent = workspace

-- สุ่มตำแหน่งในแมพ
local function getRandomPosition()
	local x = MAP_CENTER.X + math.random(-MAP_SIZE.X/2, MAP_SIZE.X/2)
	local z = MAP_CENTER.Z + math.random(-MAP_SIZE.Z/2, MAP_SIZE.Z/2)

	return Vector3.new(x, MAP_CENTER.Y, z)
end

-- เพิ่ม EXP ให้ผู้เล่น
local function addEXP(player, amount)
	local leaderstats = player:FindFirstChild("leaderstats")

	if leaderstats then
		local EXP = leaderstats:FindFirstChild("EXP")

		if EXP then
			EXP.Value += amount
		end
	end
end

-- สร้างอาหาร
local function spawnFood(foodData)

	local part = Instance.new("Part")
	part.Name = foodData.Name
	part.Size = Vector3.new(2, 2, 2)
	part.Position = getRandomPosition()
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.Parent = FoodFolder

	-- แสดง Emoji
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.new(0, 70, 0, 70)
	gui.StudsOffset = Vector3.new(0, 2, 0)
	gui.AlwaysOnTop = true
	gui.Parent = part

	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Text = foodData.Name
	text.TextScaled = true
	text.Parent = gui

	local collected = false

	part.Touched:Connect(function(hit)

		if collected then
			return
		end

		local character = hit.Parent
		local player = Players:GetPlayerFromCharacter(character)

		if player then
			collected = true

			-- ให้ EXP
			addEXP(player, foodData.EXP)

			-- หายไป
			part:Destroy()

			-- รอเวลาแล้วเกิดใหม่
			task.delay(foodData.RespawnTime, function()
				spawnFood(foodData)
			end)
		end
	end)
end

-- สร้างระบบ EXP ให้ผู้เล่น
Players.PlayerAdded:Connect(function(player)

	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"
	leaderstats.Parent = player

	local EXP = Instance.new("IntValue")
	EXP.Name = "EXP"
	EXP.Value = 0
	EXP.Parent = leaderstats
end)

-- สร้างอาหารเริ่มต้นทั่วแมพ
for _, food in ipairs(Foods) do

	for i = 1, 10 do
		spawnFood(food)
	end

end
