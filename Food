/* =========================================================
   FOOD SYSTEM
========================================================= */

const foods = [];

const FOOD_TYPES = [
    {
        emoji: "🌱",
        name: "หญ้า",
        xp: 1,
        count: 80
    },
    {
        emoji: "🍎",
        name: "แอปเปิ้ล",
        xp: 5,
        count: 40
    },
    {
        emoji: "🥩",
        name: "เนื้อสัตว์",
        xp: 10,
        count: 25
    }
];


/* สร้างอาหารเป็นอีโมจิ 3D */

function createFood(type){

    const canvas =
        document.createElement("canvas");

    canvas.width = 128;
    canvas.height = 128;

    const ctx =
        canvas.getContext("2d");

    ctx.clearRect(
        0,
        0,
        128,
        128
    );

    ctx.font = "90px Arial";

    ctx.textAlign = "center";
    ctx.textBaseline = "middle";

    ctx.fillText(
        type.emoji,
        64,
        64
    );


    const texture =
        new THREE.CanvasTexture(
            canvas
        );


    const material =
        new THREE.SpriteMaterial({
            map: texture,
            transparent: true
        });


    const sprite =
        new THREE.Sprite(
            material
        );


    sprite.scale.set(
        2,
        2,
        1
    );


    return sprite;

}


/* =========================================================
   สร้างอาหารทั่วแมพ
========================================================= */

function spawnFoods(){

    FOOD_TYPES.forEach(
        type=>{

            for(
                let i=0;
                i<type.count;
                i++
            ){

                const food =
                    createFood(type);


                food.position.set(

                    Math.random()*180-90,

                    1.3,

                    Math.random()*180-90

                );


                world.add(food);


                foods.push({

                    object:food,

                    name:type.name,

                    emoji:type.emoji,

                    xp:type.xp,

                    collected:false

                });

            }

        }
    );

}


/* =========================================================
   ตรวจว่าเดินเก็บอาหารหรือยัง
========================================================= */

function updateFoods(){

    foods.forEach(
        food=>{

            if(food.collected)
                return;


            const distance =
                food.object.position
                .distanceTo(
                    player.position
                );


            /*
               เดินเข้าใกล้อาหาร
               แล้วเก็บทันที
            */

            if(distance < 2){

                food.collected=true;


                world.remove(
                    food.object
                );


                addXP(
                    food.xp
                );


                showMessage(

                    food.emoji +
                    " เก็บ" +
                    food.name +
                    " +" +
                    food.xp +
                    " XP"

                );

            }

        }
    );

}
